<view style="padding:24rpx;">
  <view class="card">
    <view style="font-size:34rpx;font-weight:700;">{{user.nickname}}</view>
    <view style="margin-top:8rpx;color:#5c6b7a;">{{user.city}} · 信用分 {{user.credits}}</view>
    <view style="margin-top:8rpx;color:#4a90e2;">累计交换信息 {{stats.totalPosts}} 条</view>
  </view>

  <view class="card">
    <view style="font-weight:700;">我的技能标签</view>
    <view style="margin-top:12rpx;">
      <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view style="font-weight:700;">快速入口</view>
    <view style="display:flex;gap:16rpx;margin-top:16rpx;">
      <button size="mini">我的发布</button>
      <button size="mini">我的消息</button>
      <button size="mini">帮助中心</button>
    </view>
  </view>
</view>
